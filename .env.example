# ============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit real keys.
# The values below are placeholders — the app treats them as "not configured".
# ============================================================================

# --- Supabase (client + server auth) ---
# Project URL (https://app.supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public anon key (safe to ship to the browser; RLS policies protect the data)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Gemini AI (SERVER-ONLY — never put this in a VITE_ variable) ---
# Used by the Express API (server/config.ts). Do NOT prefix with VITE_,
# otherwise it gets inlined into the client bundle and leaked to visitors.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Etherscan (SERVER-ONLY — used by /api/payments/verify-transaction) ---
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# --- Payment wallet (server-side verification target; must match the address
#     shown in src/config/payments.ts) ---
PAYMENT_ETH_ADDRESS=0x388C818CA8B9251b393131C08a736A67ccB19297

# --- Cashfree Payment Gateway (SERVER-ONLY — never expose the secret) ---
# Get test keys from https://merchant.cashfree.com (Test mode).
# CASHFREE_ENV: sandbox for testing, production for live.
CASHFREE_API_KEY=YOUR_CASHFREE_CLIENT_ID
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY
CASHFREE_ENV=sandbox
